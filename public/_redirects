# Host-level redirects (.org -> .com, www -> apex) are NOT here: Pages matches
# only the path in this file, so a rule with a hostname in it never fires. They
# live in functions/_middleware.ts instead.

# Legacy routes from the Next.js site. The /blogs/<slug> URLs are unchanged,
# so only the aliases below need forwarding.
/blog                /blogs        301
/blog/*              /blogs/:splat 301
/posts               /blogs        301
/posts/*             /blogs/:splat 301
/cv                  /resume       301
/feed                /rss.xml      301
/feed.xml            /rss.xml      301
