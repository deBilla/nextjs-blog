---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../site";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  canonical?: string;
  noindex?: boolean;
  /** Widen the content column (used by the CV). */
  wide?: boolean;
}

const { wide = false, ...head } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead {...head} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class:list={["wrap", { "wrap-wide": wide }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    padding-top: clamp(2.5rem, 1.8rem + 3vw, 4.5rem);
  }
</style>
