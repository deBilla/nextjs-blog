---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { formatDate, isoDate, isSyndicatedStub, readingTime, type Post } from "../utils/posts";
import { SITE } from "../site";

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  prev?: Post;
  next?: Post;
}

const { post, headings, prev, next } = Astro.props;
const { title, date, preview, mediumUrl, canonicalUrl } = post.data;
const stub = isSyndicatedStub(post);

// A summary of a piece that lives on Medium should point search engines there,
// not compete with it. Full posts stay canonical here.
const canonical = canonicalUrl ?? (stub && mediumUrl ? mediumUrl : undefined);

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: preview,
  datePublished: date.toISOString(),
  author: { "@type": "Person", name: SITE.author, url: SITE.url },
  mainEntityOfPage: new URL(`/blogs/${post.id}`, SITE.url).href,
  image: new URL(`/og/${post.id}.png`, SITE.url).href,
};
---

<BaseLayout
  title={title}
  description={preview}
  image={`/og/${post.id}.png`}
  type="article"
  publishedAt={date}
  canonical={canonical}
  wide
>
  <div class="progress no-print" aria-hidden="true"><span id="progress-bar"></span></div>

  <article class="post">
    <header class="post-head">
      <p class="meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post)}</span>
      </p>
      <h1>{title}</h1>
      <p class="lede">{preview}</p>
    </header>

    <div class="post-grid">
      <div class="post-body">
        {
          stub && mediumUrl && (
            <aside class="syndicated">
              <p>
                This is a summary. The full article is published on{" "}
                <a href={mediumUrl} rel="noopener noreferrer">
                  Medium
                </a>
                .
              </p>
            </aside>
          )
        }

        <div class="prose">
          <slot />
        </div>

        {
          mediumUrl && !stub && (
            <p class="also">
              Also published on{" "}
              <a href={mediumUrl} rel="noopener noreferrer">
                Medium
              </a>
              .
            </p>
          )
        }

        <nav class="post-nav no-print" aria-label="More posts">
          {
            prev && (
              <a class="prev" href={`/blogs/${prev.id}`}>
                <span class="dir">← Previous</span>
                <span class="name">{prev.data.title}</span>
              </a>
            )
          }
          {
            next && (
              <a class="next" href={`/blogs/${next.id}`}>
                <span class="dir">Next →</span>
                <span class="name">{next.data.title}</span>
              </a>
            )
          }
        </nav>
      </div>

      <aside class="rail">
        <div class="rail-inner">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: 30;
    pointer-events: none;
  }

  .progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    transform-origin: left;
  }

  .post-head {
    max-width: 44rem;
    margin-inline: auto;
    margin-bottom: 3rem;
  }

  .post-head h1 {
    margin-top: 0.5rem;
  }

  .lede {
    margin-top: 1rem;
    font-family: var(--font-prose);
    font-size: var(--step-2);
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: var(--measure);
    text-wrap: pretty;
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 44rem);
    justify-content: center;
  }

  .post-body {
    min-width: 0;
  }

  .rail {
    display: none;
  }

  /* Only promote the TOC to a sidebar when there is genuinely room for it. */
  @media (min-width: 1180px) {
    .post-grid {
      grid-template-columns: minmax(0, 44rem) 13rem;
      column-gap: 4rem;
    }

    .rail {
      display: block;
    }

    .rail-inner {
      position: sticky;
      top: 5.5rem;
      max-height: calc(100dvh - 8rem);
      overflow-y: auto;
    }
  }

  .syndicated {
    margin-bottom: 2rem;
    padding: 0.9rem 1.1rem;
    background: var(--accent-subtle);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }

  .syndicated a {
    color: var(--accent);
    font-weight: 500;
  }

  .also {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .also a {
    color: var(--accent);
  }

  .post-nav {
    display: grid;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr 1fr;
    }
  }

  .post-nav a {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s var(--ease);
  }

  .post-nav a:hover {
    border-color: var(--accent);
  }

  .post-nav .next {
    text-align: right;
  }

  .post-nav .dir {
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .post-nav .name {
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.35;
  }
</style>

<script>
  // Reading progress.
  const bar = document.getElementById("progress-bar");
  if (bar) {
    const update = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? window.scrollY / scrollable : 0;
      bar.style.width = `${Math.min(100, Math.max(0, ratio * 100))}%`;
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
  }

  // Copy-to-clipboard on every code block.
  const COPY_ICON = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>`;
  const DONE_ICON = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9 17.5 20 6.5"/></svg>`;

  document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
    const wrapper = document.createElement("div");
    wrapper.className = "code-block";
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy";
    button.innerHTML = COPY_ICON;
    button.setAttribute("aria-label", "Copy code");
    wrapper.appendChild(button);

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        button.innerHTML = DONE_ICON;
        button.setAttribute("aria-label", "Copied");
        setTimeout(() => {
          button.innerHTML = COPY_ICON;
          button.setAttribute("aria-label", "Copy code");
        }, 1600);
      } catch {
        /* Clipboard unavailable — leave the button as-is. */
      }
    });
  });

  // Let wide tables scroll on their own rather than stretching the page.
  document.querySelectorAll<HTMLTableElement>(".prose table").forEach((table) => {
    const scroller = document.createElement("div");
    scroller.className = "table-scroll";
    table.parentNode?.insertBefore(scroller, table);
    scroller.appendChild(table);
  });
</script>
