---
import BaseLayout from "../layouts/BaseLayout.astro";
import portfolio from "../data/portfolio.json";
import { breadcrumbs, graph, person, website, PERSON_ID, SITE_ID } from "../utils/schema";
import { bulletsFor, hasDetail } from "../utils/resume-detail";
import AskArchive from "../components/AskArchive.astro";
import { SITE } from "../site";

const { resume, socials } = portfolio;
const email = socials.find((s) => s.title === "Email")?.link.replace("mailto:", "");
const contactLinks = socials.filter((s) => s.title !== "Email" && s.title !== "Blog");

// Two documents out of one template. Without the private detail file this is
// the public summary — roles, dates, scope, no achievement bullets — and it
// carries the request form. A local build has the file and renders the full CV
// for `npm run resume:pdf`, so what a recipient reads is never a separately
// maintained copy that drifts from the site.
const isFull = hasDetail;

const schema = graph(
  person,
  website,
  {
    "@type": "ProfilePage",
    "@id": `${SITE.url}/resume`,
    url: `${SITE.url}/resume`,
    name: `${SITE.author} — Resume`,
    inLanguage: "en",
    isPartOf: { "@id": SITE_ID },
    mainEntity: { "@id": PERSON_ID },
  },
  breadcrumbs([["Home", "/"], ["Resume", "/resume"]])
);
---

<BaseLayout
  title="Resume"
  description={`${SITE.author} — ${resume.tagline}. ${resume.description}`}
>
  <div class="cv">
    <header class="cv-head cv-section">
      <div>
        <h1>{portfolio.name}</h1>
        <p class="role">{resume.tagline}</p>
      </div>
      <ul class="contact">
        <li>{resume.location}</li>
        {isFull && email && <li><a href={`mailto:${email}`}>{email}</a></li>}
        {
          contactLinks.map((social) => (
            <li>
              <a href={social.link} rel="noopener noreferrer">
                {social.title}
              </a>
            </li>
          ))
        }
        <li><a href={SITE.url}>{SITE.url.replace(/^https?:\/\//, "")}</a></li>
      </ul>
    </header>

    <p class="summary cv-section">{resume.description}</p>

    {isFull && <button class="print-btn no-print" type="button" id="print-cv">Print / Save as PDF</button>}

    {
      !isFull && (
        <section class="request" aria-labelledby="request-heading">
          <h2 id="request-heading">Full CV on request</h2>
          <p>
            This page is the summary — roles, scope and stack. The full CV adds the detailed
            project work and outcomes for each role. Tell me who you are and I'll send it over.
          </p>
          <form id="resume-request" novalidate>
            <div class="fields">
              <label>
                <span>Name</span>
                <input type="text" name="name" required autocomplete="name" />
              </label>
              <label>
                <span>Email</span>
                <input type="email" name="email" required autocomplete="email" />
              </label>
              <label>
                <span>Company <em>(optional)</em></span>
                <input type="text" name="org" autocomplete="organization" />
              </label>
              <label class="full">
                <span>What's this about? <em>(optional)</em></span>
                <textarea name="message" rows="3"></textarea>
              </label>
            </div>
            {/* Bots fill every field they find; humans never see this one. */}
            <label class="trap" aria-hidden="true">
              Leave this empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
            <div class="actions">
              <button type="submit">Request the CV</button>
              <p class="status" role="status" aria-live="polite" />
            </div>
          </form>
        </section>
      )
    }

    <section class="cv-section">
      <h2>Experience</h2>
      {
        resume.experiences.map((job) => (
          <article class="job">
            <div class="job-head">
              <h3>
                {job.position} <span class="at">·</span> <span class="company">{job.company}</span>
              </h3>
              <p class="dates">{job.dates}</p>
            </div>
            <p class="context">
              {job.context} <span class="at">·</span> {job.location}
            </p>
            {bulletsFor(job.company).length > 0 && (
              <ul>
                {bulletsFor(job.company).map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </section>

    <section class="cv-section">
      <h2>Selected work</h2>
      <ul class="work">
        {
          resume.selectedWork.map((project) => (
            <li>
              <a href={project.url} rel="noopener noreferrer">
                {project.title}
              </a>
              <span> — {project.description}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cv-section">
      <h2>Skills</h2>
      <dl class="skills">
        {
          resume.skills.map((group) => (
            <div>
              <dt>{group.label}</dt>
              <dd>{group.items.join(" · ")}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv-section">
      <h2>Education</h2>
      <div class="job-head">
        <h3>{resume.education.universityPara}</h3>
        <p class="dates">{resume.education.universityDate}</p>
      </div>
      <p class="uni">{resume.education.universityName}</p>
    </section>

    <AskArchive compact />
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>

<style>
  .cv {
    max-width: 46rem;
    margin-inline: auto;
  }

  .cv-head {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .cv-head h1 {
    font-size: var(--step-3);
  }

  .role {
    margin-top: 0.3rem;
    color: var(--ink-muted);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--step--1);
  }

  .contact a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .contact a:hover {
    color: var(--accent);
  }

  .summary {
    margin-top: 1.5rem;
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  .print-btn {
    margin-top: 1.5rem;
    padding: 0.45rem 0.9rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: var(--step--1);
    color: var(--ink-muted);
    cursor: pointer;
    transition: border-color 0.15s var(--ease), color 0.15s var(--ease);
  }

  .print-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  section {
    margin-top: 3rem;
  }

  section h2 {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  .job {
    margin-top: 1.75rem;
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .job-head h3 {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .at {
    color: var(--ink-faint);
    font-weight: 400;
  }

  .company {
    color: var(--accent);
  }

  .dates {
    font-size: var(--step--1);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .context {
    margin-top: 0.15rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .job ul {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.55;
  }

  .job li::marker {
    color: var(--ink-faint);
  }

  .work {
    margin: 1.25rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.55;
  }

  .work a {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .work a:hover {
    color: var(--accent);
  }

  .skills {
    margin: 1.25rem 0 0;
    display: grid;
    gap: 0.85rem;
  }

  .skills div {
    display: grid;
    gap: 0.15rem;
  }

  @media (min-width: 640px) {
    .skills div {
      grid-template-columns: 9rem 1fr;
      gap: 0 1rem;
    }
  }

  .skills dt {
    font-weight: 600;
    font-size: var(--step--1);
  }

  .skills dd {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .uni {
    margin-top: 0.3rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  /* --- Request-the-full-CV block (public build only) ---------------------- */

  .request {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  .request h2 {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none;
    color: var(--ink);
    border-bottom: 0;
    padding-bottom: 0;
  }

  .request > p {
    margin-top: 0.5rem;
    max-width: var(--measure);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.9rem;
    margin-top: 1.25rem;
  }

  .fields .full {
    grid-column: 1 / -1;
  }

  .fields label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: var(--step--1);
  }

  .fields em {
    color: var(--ink-faint);
    font-style: normal;
  }

  input,
  textarea {
    padding: 0.5rem 0.65rem;
    font: inherit;
    font-size: var(--step--1);
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  textarea {
    resize: vertical;
  }

  /* Off-screen rather than display:none — bots skip hidden inputs. */
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1.1rem;
  }

  .actions button {
    padding: 0.5rem 1rem;
    font: inherit;
    font-size: var(--step--1);
    color: var(--bg);
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .actions button:disabled {
    opacity: 0.55;
    cursor: progress;
  }

  .status {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .status[data-kind="ok"] {
    color: var(--accent);
  }

  .status[data-kind="err"] {
    color: #b3261e;
  }

  @media print {
    section {
      margin-top: 1.5rem;
    }

    /* Asking for the CV makes no sense on a printed copy of it. */
    .request {
      display: none;
    }

    .job {
      margin-top: 1rem;
    }

    .summary {
      max-width: none;
    }

    /* Sections have to be allowed to flow across a page boundary. Experience
       alone runs longer than a page, so pinning the whole section (the global
       `.cv-section { break-inside: avoid }`) pushed it to page 2 and left the
       first page two-thirds empty. Keep individual entries intact instead —
       that is the unit a reader actually wants unbroken. */
    .cv-section {
      break-inside: auto;
    }

    /* The Bitsmedia entry is a full page on its own, so it cannot be kept
       whole either — pinning it just moves the hole from one page to the next.
       Only the title/date block is protected, and it is glued to the bullets
       that follow so a heading never ends a page alone. */
    .job {
      break-inside: auto;
    }

    .job-head {
      break-inside: avoid;
      break-after: avoid;
    }

    .work li,
    .skills > div,
    .job li {
      break-inside: avoid;
    }

    /* A heading stranded at the foot of a page reads as a mistake. */
    section h2 {
      break-after: avoid;
    }

    li {
      orphans: 2;
      widows: 2;
    }
  }
</style>

<script>
  document.getElementById("print-cv")?.addEventListener("click", () => window.print());

  const form = document.getElementById("resume-request") as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector(".status") as HTMLParagraphElement;
    const submit = form.querySelector("button[type=submit]") as HTMLButtonElement;

    const say = (text: string, kind: "ok" | "err" | "") => {
      status.textContent = text;
      status.dataset.kind = kind;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form));

      if (!String(data.name).trim() || !String(data.email).includes("@")) {
        say("A name and a working email address, please.", "err");
        return;
      }

      submit.disabled = true;
      say("Sending…", "");

      try {
        const res = await fetch("/api/resume-request", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.querySelector(".fields")?.remove();
        form.querySelector(".actions button")?.remove();
        say("Sent — I'll email the CV shortly. Thanks for asking.", "ok");
      } catch {
        // The request never reached me, so the fallback has to be something the
        // visitor can act on alone rather than a "try again later".
        const addr = ["dimuthu.billa", "gmail.com"].join("@");
        say("", "err");
        status.innerHTML =
          `That didn't send. Email me directly at <a href="mailto:${addr}?subject=CV%20request">${addr}</a>.`;
        status.dataset.kind = "err";
        submit.disabled = false;
      }
    });
  }
</script>
