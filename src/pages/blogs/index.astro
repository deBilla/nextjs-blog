---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import AskArchive from "../../components/AskArchive.astro";
import { canonicalFor, getPosts, groupByYear } from "../../utils/posts";
import { breadcrumbs, graph, person, website, PERSON_ID, SITE_ID } from "../../utils/schema";
import { SITE } from "../../site";

const posts = await getPosts();
const years = groupByYear(posts);

const schema = graph(
  person,
  website,
  {
    "@type": "Blog",
    "@id": `${SITE.url}/blogs#blog`,
    url: `${SITE.url}/blogs`,
    name: `${SITE.author} — Writing`,
    description:
      "Articles on distributed systems, platform engineering, and AI infrastructure.",
    inLanguage: "en",
    author: { "@id": PERSON_ID },
    publisher: { "@id": PERSON_ID },
    isPartOf: { "@id": SITE_ID },
    blogPost: posts.map((post) => ({
      "@type": "BlogPosting",
      "@id": `${canonicalFor(post, SITE.url)}#article`,
      headline: post.data.title,
      url: canonicalFor(post, SITE.url),
      datePublished: post.data.date.toISOString(),
    })),
  },
  breadcrumbs([["Home", "/"], ["Writing", "/blogs"]])
);
---

<BaseLayout
  title="Writing"
  description="Articles on distributed systems, platform engineering, and AI infrastructure."
>
  <header class="head">
    <h1>Writing</h1>
    <p>
      {posts.length} posts on distributed systems, platform engineering, and the parts of
      AI infrastructure that actually break. <a href="/rss.xml">Subscribe via RSS</a>.
    </p>
  </header>

  <AskArchive />

  {
    years.map(([year, yearPosts]) => (
      <section class="year">
        <h2>{year}</h2>
        <PostList posts={yearPosts} compact />
      </section>
    ))
  }

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>

<style>
  .head {
    max-width: var(--measure);
    margin-bottom: 3.5rem;
  }

  .head p {
    margin-top: 1rem;
    color: var(--ink-muted);
  }

  .head a {
    color: var(--accent);
  }

  .year {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  .year h2 {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  /* On wide screens the year label sits out in the margin. */
  @media (min-width: 900px) {
    .year {
      grid-template-columns: 4rem 1fr;
      gap: 0 2rem;
      align-items: start;
    }

    .year h2 {
      position: sticky;
      top: 5rem;
      padding-top: 0.35rem;
    }
  }
</style>
