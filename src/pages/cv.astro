---
import BaseLayout from "../layouts/BaseLayout.astro";
import portfolio from "../data/portfolio.json";
import { SITE } from "../site";

const { resume, socials, projects } = portfolio;
const email = socials.find((s) => s.title === "Email")?.link.replace("mailto:", "");
const contactLinks = socials.filter((s) => s.title !== "Email" && s.title !== "Blog");
const highlighted = projects.slice(0, 4);

const skillGroups = [
  { label: "Languages", items: resume.languages },
  { label: "Frameworks", items: resume.frameworks },
  { label: "Platform & Data", items: resume.others },
];
---

<BaseLayout
  title="CV"
  description={`${SITE.author} — ${resume.tagline}. ${resume.description}`}
>
  <div class="cv">
    <header class="cv-head cv-section">
      <div>
        <h1>{portfolio.name}</h1>
        <p class="role">{resume.tagline}</p>
      </div>
      <ul class="contact">
        {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
        {
          contactLinks.map((social) => (
            <li>
              <a href={social.link} rel="noopener noreferrer">
                {social.title}
              </a>
            </li>
          ))
        }
        <li><a href={SITE.url}>billacode.org</a></li>
      </ul>
    </header>

    <p class="summary cv-section">{resume.description}</p>

    <button class="print-btn no-print" type="button" id="print-cv">Print / Save as PDF</button>

    <section class="cv-section">
      <h2>Experience</h2>
      {
        resume.experiences.map((job) => (
          <article class="job">
            <div class="job-head">
              <h3>
                {job.position} <span class="at">·</span> <span class="company">{job.company}</span>
              </h3>
              <p class="dates">{job.dates}</p>
            </div>
            <ul>
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section class="cv-section">
      <h2>Selected work</h2>
      <ul class="work">
        {
          highlighted.map((project) => (
            <li>
              <a href={project.url} rel="noopener noreferrer">
                {project.title}
              </a>
              <span> — {project.description}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cv-section">
      <h2>Skills</h2>
      <dl class="skills">
        {
          skillGroups.map((group) => (
            <div>
              <dt>{group.label}</dt>
              <dd>{group.items.join(" · ")}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv-section">
      <h2>Education</h2>
      <div class="job-head">
        <h3>{resume.education.universityPara}</h3>
        <p class="dates">{resume.education.universityDate}</p>
      </div>
      <p class="uni">{resume.education.universityName}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .cv {
    max-width: 46rem;
    margin-inline: auto;
  }

  .cv-head {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .cv-head h1 {
    font-size: var(--step-3);
  }

  .role {
    margin-top: 0.3rem;
    color: var(--ink-muted);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--step--1);
  }

  .contact a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .contact a:hover {
    color: var(--accent);
  }

  .summary {
    margin-top: 1.5rem;
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  .print-btn {
    margin-top: 1.5rem;
    padding: 0.45rem 0.9rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: var(--step--1);
    color: var(--ink-muted);
    cursor: pointer;
    transition: border-color 0.15s var(--ease), color 0.15s var(--ease);
  }

  .print-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  section {
    margin-top: 3rem;
  }

  section h2 {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  .job {
    margin-top: 1.75rem;
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .job-head h3 {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .at {
    color: var(--ink-faint);
    font-weight: 400;
  }

  .company {
    color: var(--accent);
  }

  .dates {
    font-size: var(--step--1);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .job ul {
    margin: 0.7rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.55;
  }

  .job li::marker {
    color: var(--ink-faint);
  }

  .work {
    margin: 1.25rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.55;
  }

  .work a {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .work a:hover {
    color: var(--accent);
  }

  .skills {
    margin: 1.25rem 0 0;
    display: grid;
    gap: 0.85rem;
  }

  .skills div {
    display: grid;
    gap: 0.15rem;
  }

  @media (min-width: 640px) {
    .skills div {
      grid-template-columns: 9rem 1fr;
      gap: 0 1rem;
    }
  }

  .skills dt {
    font-weight: 600;
    font-size: var(--step--1);
  }

  .skills dd {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .uni {
    margin-top: 0.3rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  @media print {
    section {
      margin-top: 1.5rem;
    }

    .job {
      margin-top: 1rem;
    }

    .summary {
      max-width: none;
    }
  }
</style>

<script>
  document.getElementById("print-cv")?.addEventListener("click", () => window.print());
</script>
