---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <div class="notfound">
    <p class="code">404</p>
    <h1>This page doesn't exist</h1>
    <p class="body">
      The link may be out of date, or the page may have moved. Try the
      <a href="/blogs">writing archive</a> or head <a href="/">home</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .notfound {
    max-width: var(--measure);
    padding-block: 3rem 6rem;
  }

  .code {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  h1 {
    margin-top: 0.75rem;
    font-size: var(--step-3);
  }

  .body {
    margin-top: 1rem;
    color: var(--ink-muted);
  }

  .body a {
    color: var(--accent);
  }
</style>
