---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import portfolio from "../data/portfolio.json";
import { getPosts } from "../utils/posts";
import { getRepos } from "../utils/github";
import RepoScroller from "../components/RepoScroller.astro";
import { graph, person, website } from "../utils/schema";
import { SITE } from "../site";

const posts = await getPosts();
const recent = posts.slice(0, 6);
const featured = portfolio.apps;
const repos = await getRepos();

const schema = graph(person, website);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="intro">
    <h1>I build AI platforms and agent infrastructure.</h1>
    <p class="tagline">
      MCP servers, LLM assistants, and the Kubernetes and data platforms underneath them
      — and writing about what the tradeoffs actually cost.
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Recent writing</h2>
      <a class="more" href="/blogs">All {posts.length} posts →</a>
    </div>
    <PostList posts={recent} />
  </section>

  <section class="section">
    <h2>Things I've built</h2>
    <ul class="projects">
      {
        featured.map((app) => (
          <li>
            <a href={app.url} rel="noopener noreferrer">
              <span class="name">{app.title}</span>
              <span class="desc">{app.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    repos.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>On GitHub</h2>
          <a class="more" href="https://github.com/deBilla" rel="noopener noreferrer">
            {repos.length} repositories →
          </a>
        </div>
        <RepoScroller repos={repos} label="GitHub repositories, ordered by stars" />
      </section>
    )
  }

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>

<style>
  .intro {
    max-width: 30rem;
  }

  .intro h1 {
    font-size: var(--step-3);
    letter-spacing: -0.025em;
  }

  .tagline {
    margin-top: 1rem;
    font-family: var(--font-prose);
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .section {
    margin-top: 5rem;
  }

  .section h2 {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-head + :global(*) {
    margin-top: 2rem;
  }

  .section h2 + .projects {
    margin-top: 1.5rem;
  }

  .more {
    font-size: var(--step--1);
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .more:hover {
    color: var(--accent);
  }

  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .projects {
      grid-template-columns: 1fr 1fr;
    }
  }

  .projects a {
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s var(--ease);
  }

  .projects a:hover {
    border-color: var(--accent);
  }

  .projects .name {
    font-weight: 600;
    font-size: var(--step--1);
  }

  .projects .desc {
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.5;
  }

</style>
