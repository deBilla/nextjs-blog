---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import portfolio from "../data/portfolio.json";
import { getPosts } from "../utils/posts";
import { getTopRepos } from "../utils/github";
import { SITE } from "../site";

const posts = await getPosts();
const recent = posts.slice(0, 6);
const featured = portfolio.apps.slice(0, 4);
const repos = await getTopRepos(6);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="intro">
    <h1>Dimuthu Wickramanayake</h1>
    <p class="tagline">
      I build AI platform and agent infrastructure — MCP servers, LLM assistants, and the
      Kubernetes and data platforms underneath them — and write about what the tradeoffs
      actually cost.
    </p>
    <p class="links">
      <a href="/about">About</a>
      <span aria-hidden="true">·</span>
      <a href="/cv">CV</a>
      <span aria-hidden="true">·</span>
      <a href={portfolio.socials.find((s) => s.title === "Github")?.link}>GitHub</a>
      <span aria-hidden="true">·</span>
      <a href={portfolio.socials.find((s) => s.title === "LinkedIn")?.link}>LinkedIn</a>
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Writing</h2>
      <a class="more" href="/blogs">All {posts.length} posts →</a>
    </div>
    <PostList posts={recent} />
  </section>

  <section class="section">
    <h2>Things I've built</h2>
    <ul class="projects">
      {
        featured.map((app) => (
          <li>
            <a href={app.url} rel="noopener noreferrer">
              <span class="name">{app.title}</span>
              <span class="desc">{app.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    repos.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>On GitHub</h2>
          <a class="more" href={`https://github.com/deBilla`} rel="noopener noreferrer">
            All repositories →
          </a>
        </div>
        <ul class="repos">
          {repos.map((repo) => (
            <li>
              <a href={repo.url} rel="noopener noreferrer">
                <span class="repo-top">
                  <span class="name">{repo.name}</span>
                  <span class="stars" title={`${repo.stars} stars`}>
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                      <path d="M8 .5l2.2 4.6 5 .7-3.6 3.5.9 5L8 11.9 3.5 14.3l.9-5L.8 5.8l5-.7z" />
                    </svg>
                    {repo.stars}
                  </span>
                </span>
                {repo.description && <span class="desc">{repo.description}</span>}
                {repo.language && <span class="lang">{repo.language}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .intro {
    max-width: var(--measure);
  }

  .tagline {
    margin-top: 1.1rem;
    font-family: var(--font-prose);
    font-size: var(--step-2);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .links a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--accent);
  }

  .section {
    margin-top: 5rem;
  }

  .section h2 {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-head + :global(*) {
    margin-top: 2rem;
  }

  .section h2 + .projects {
    margin-top: 1.5rem;
  }

  .more {
    font-size: var(--step--1);
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .more:hover {
    color: var(--accent);
  }

  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .projects {
      grid-template-columns: 1fr 1fr;
    }
  }

  .projects a {
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s var(--ease);
  }

  .projects a:hover {
    border-color: var(--accent);
  }

  .projects .name {
    font-weight: 600;
    font-size: var(--step--1);
  }

  .projects .desc {
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .repos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .repos {
      grid-template-columns: 1fr 1fr;
    }
  }

  .repos a {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s var(--ease);
  }

  .repos a:hover {
    border-color: var(--accent);
  }

  .repo-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .repos .name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .stars {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .stars svg {
    width: 11px;
    height: 11px;
    fill: currentColor;
  }

  .repos .desc {
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .repos .lang {
    font-size: 0.78rem;
    color: var(--ink-faint);
  }
</style>
