---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import portfolio from "../data/portfolio.json";
import { getPosts } from "../utils/posts";
import { SITE } from "../site";

const posts = await getPosts();
const recent = posts.slice(0, 6);
const featured = portfolio.apps.slice(0, 4);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="intro">
    <h1>Dimuthu Wickramanayake</h1>
    <p class="tagline">
      Senior Platform Engineer. I build distributed systems, high-throughput API platforms,
      and AI infrastructure — and write about what the tradeoffs actually cost.
    </p>
    <p class="links">
      <a href="/about">About</a>
      <span aria-hidden="true">·</span>
      <a href="/cv">CV</a>
      <span aria-hidden="true">·</span>
      <a href={portfolio.socials.find((s) => s.title === "Github")?.link}>GitHub</a>
      <span aria-hidden="true">·</span>
      <a href={portfolio.socials.find((s) => s.title === "LinkedIn")?.link}>LinkedIn</a>
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Writing</h2>
      <a class="more" href="/blogs">All {posts.length} posts →</a>
    </div>
    <PostList posts={recent} />
  </section>

  <section class="section">
    <h2>Things I've built</h2>
    <ul class="projects">
      {
        featured.map((app) => (
          <li>
            <a href={app.url} rel="noopener noreferrer">
              <span class="name">{app.title}</span>
              <span class="desc">{app.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: var(--measure);
  }

  .tagline {
    margin-top: 1.1rem;
    font-family: var(--font-prose);
    font-size: var(--step-2);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .links a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--accent);
  }

  .section {
    margin-top: 5rem;
  }

  .section h2 {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-head + :global(*) {
    margin-top: 2rem;
  }

  .section h2 + .projects {
    margin-top: 1.5rem;
  }

  .more {
    font-size: var(--step--1);
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .more:hover {
    color: var(--accent);
  }

  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .projects {
      grid-template-columns: 1fr 1fr;
    }
  }

  .projects a {
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s var(--ease);
  }

  .projects a:hover {
    border-color: var(--accent);
  }

  .projects .name {
    font-weight: 600;
    font-size: var(--step--1);
  }

  .projects .desc {
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.5;
  }
</style>
