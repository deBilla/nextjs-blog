---
import { NAV, SITE } from "../site";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname.replace(/\.html$/, "");
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${SITE.name} — home`}>
      <span class="mark" aria-hidden="true"></span>
      {SITE.name}
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in oklch, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.6) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease);
  }

  /* The rule only appears once you have scrolled past the top. */
  :global(body.scrolled) .site-header {
    border-bottom-color: var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    margin-right: auto;
  }

  .mark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  nav ul {
    display: flex;
    gap: clamp(0.9rem, 0.5rem + 1.6vw, 1.6rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  nav a {
    font-size: var(--step--1);
    color: var(--ink-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current="page"] {
    color: var(--ink);
    font-weight: 500;
  }
</style>

<script>
  const onScroll = () => document.body.classList.toggle("scrolled", window.scrollY > 4);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
