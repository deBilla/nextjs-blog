---
/**
 * "Ask the archive" — retrieval over every post plus the public résumé summary.
 *
 * Deliberately not a chatbot. There is no model here, so nothing can synthesise
 * an answer; what it returns is the passage that answers the question, quoted
 * verbatim, with a link to its source. Framing it as a chat window would set an
 * expectation of prose that a retrieval engine cannot meet.
 */
interface Props {
  /** Trimmed-down presentation for the foot of a post, where it is a follow-up
   * rather than the reason you came to the page. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section class:list={["ask", "no-print", { compact }]} aria-label="Ask the archive">
  <h2>Ask the archive</h2>
  <p class="lede">
    {
      compact
        ? "Got a question about this or anything else here? Ask, and get the passage that answers it — from all 97 posts, in your browser."
        : "Ask a question and get the passage that answers it, quoted from the post it came from. Runs entirely in your browser — nothing you type leaves this page."
    }
  </p>

  <label class="field">
    <span class="sr-only">Search the archive</span>
    <input
      type="search"
      placeholder="why did disabling the cache break the database?"
      autocomplete="off"
      spellcheck="false"
    />
  </label>

  <p class="status" role="status" aria-live="polite"></p>
  <div class="results"></div>
</section>

<script>
  import { buildRuntime, hasProfileIntent, highlight, search, type Runtime } from "../utils/search-runtime";
  import type { Chunk } from "../utils/search-index";

  // Module scope, so two instances on one page share a single fetch and a
  // single built index rather than each paying for their own.
  let runtime: Runtime | null = null;
  let loading: Promise<void> | null = null;

  for (const root of document.querySelectorAll<HTMLElement>(".ask")) {
    const input = root.querySelector("input") as HTMLInputElement;
    const results = root.querySelector(".results") as HTMLDivElement;
    const status = root.querySelector(".status") as HTMLParagraphElement;

    /** Fetch and index on first use — never on page load. */
    const load = () => {
      if (loading) return loading;
      status.textContent = "Loading the archive…";
      loading = fetch("/search-index.json")
        .then((res) => {
          if (!res.ok) throw new Error(String(res.status));
          return res.json() as Promise<{ chunks: Chunk[] }>;
        })
        .then((data) => {
          runtime = buildRuntime(data.chunks);
          status.textContent = "";
        })
        .catch(() => {
          status.textContent = "Couldn't load the archive. Try the post list below.";
          loading = null;
        });
      return loading;
    };

    const escapeAttr = (s: string) =>
      s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");

    // A card, not a quote. Questions about his work get acknowledged and routed
    // to the résumé rather than having CV passages read out in a search widget —
    // the summary lives on one page by design, and the detail is only handed
    // over on request.
    //
    // On the résumé itself, "see the resume" would be pointing at the page the
    // reader is already on, so the same question routes to the request form.
    const onResume = location.pathname.replace(/\/$/, "") === "/resume";

    const profileCard = onResume
      ? `
      <article class="hit profile">
        <p class="source">About my work</p>
        <p class="answer">
          The summary is on this page — roles, scope and stack. The detailed project
          work and outcomes for each role are available on request.
        </p>
        <a href="#request-heading">Ask for the full CV →</a>
      </article>`
      : `
      <article class="hit profile">
        <p class="source">About my work</p>
        <p class="answer">
          Questions about my experience are answered on the resume page — roles, scope
          and stack are there, and the detailed project work is available on request.
        </p>
        <a href="/resume">See the resume →</a>
      </article>`;

    const render = (query: string) => {
      if (!runtime) return;

      // Ask for more than we show: the résumé hits are consumed as a signal
      // rather than rendered, so they must not eat the visible slots.
      const hits = search(query, runtime, 6);
      const isProfile = hasProfileIntent(query);
      const shown = hits.filter((h) => h.chunk.k !== "resume").slice(0, 3);

      if (!hits.length) {
        results.innerHTML = "";
        status.textContent = `Nothing in the archive matches "${query}".`;
        return;
      }

      status.textContent = "";
      results.innerHTML = (isProfile ? profileCard : "") + shown
        .map(({ chunk, matched }) => {
          const meta = [chunk.d, chunk.w].filter(Boolean).join(" · ");
          const heading = chunk.h ? `<span class="heading">${escapeAttr(chunk.h)}</span>` : "";
          return `
            <article class="hit">
              <p class="source">${escapeAttr(meta)}</p>
              ${heading}
              <blockquote>${highlight(chunk.t, matched)}</blockquote>
              <a href="${escapeAttr(chunk.u)}">Read it in context →</a>
            </article>`;
        })
        .join("");
    };

    let timer: ReturnType<typeof setTimeout>;
    const onInput = async () => {
      const query = input.value.trim();
      clearTimeout(timer);

      if (query.length < 3) {
        results.innerHTML = "";
        status.textContent = "";
        return;
      }

      // Short debounce: scoring is sub-millisecond, so this is about not
      // re-rendering on every keystroke rather than about cost.
      timer = setTimeout(async () => {
        await load();
        render(query);
      }, 120);
    };

    input.addEventListener("input", onInput);
    // Warm the index while the first question is still being typed.
    input.addEventListener("focus", load, { once: true });
  }
</script>

<style>
  .ask.compact {
    margin-top: 3rem;
    padding: 1.25rem;
  }

  .ask.compact h2 {
    font-size: var(--step-0);
  }

  .ask {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  .ask h2 {
    font-size: var(--step-1);
  }

  .lede {
    margin-top: 0.4rem;
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .field {
    display: block;
    margin-top: 1rem;
  }

  input {
    width: 100%;
    padding: 0.6rem 0.8rem;
    font: inherit;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .status {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
    min-height: 1.2em;
  }

  .results {
    display: grid;
    gap: 1rem;
  }

  .results:not(:empty) {
    margin-top: 0.4rem;
  }

  .hit {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .source {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .heading {
    display: block;
    margin-top: 0.15rem;
    font-weight: 600;
    font-size: var(--step--1);
  }

  blockquote {
    margin: 0.5rem 0 0;
    font-family: var(--font-prose);
    line-height: 1.6;
    color: var(--ink);
  }

  /* The whole point of the feature: the words you asked for, in the answer. */
  blockquote :global(mark) {
    background: color-mix(in oklch, var(--accent) 22%, transparent);
    color: inherit;
    border-radius: 2px;
    padding: 0 0.1em;
  }

  .hit a {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: var(--step--1);
  }

  /* The referral card answers rather than quotes, so it reads as a statement
     instead of an excerpt. */
  .results :global(.profile .answer) {
    margin-top: 0.35rem;
    max-width: var(--measure);
    color: var(--ink);
  }
</style>
