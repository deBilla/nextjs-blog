---
import { formatDate, isoDate, isSyndicatedStub, readingTime, type Post } from "../utils/posts";

interface Props {
  posts: Post[];
  /** Hide the preview line for denser archive listings. */
  compact?: boolean;
}

const { posts, compact = false } = Astro.props;
---

<ul class:list={["posts", { compact }]}>
  {
    posts.map((post) => (
      <li>
        <article>
          <a class="title" href={`/blogs/${post.id}`}>
            {post.data.title}
          </a>
          <p class="meta">
            <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime(post)}</span>
            {isSyndicatedStub(post) && (
              <>
                <span aria-hidden="true">·</span>
                <span class="badge">on Medium</span>
              </>
            )}
          </p>
          {!compact && <p class="preview">{post.data.preview}</p>}
        </article>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2.25rem;
  }

  .posts.compact {
    gap: 1.35rem;
  }

  .title {
    display: inline-block;
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    text-decoration: none;
    text-wrap: balance;
  }

  .compact .title {
    font-size: var(--step-1);
  }

  .title:hover {
    color: var(--accent);
  }

  .meta {
    margin-top: 0.35rem;
  }

  .badge {
    color: var(--ink-faint);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0.05rem 0.45rem;
    font-size: 0.78rem;
  }

  .preview {
    margin-top: 0.55rem;
    color: var(--ink-muted);
    max-width: var(--measure);
  }
</style>
