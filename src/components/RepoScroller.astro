---
import type { Repo } from "../utils/github";

interface Props {
  repos: Repo[];
  label: string;
}

const { repos, label } = Astro.props;
---

<div class="scroller">
  <div class="controls no-print">
    <button type="button" data-dir="-1" aria-label="Scroll left" disabled>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button type="button" data-dir="1" aria-label="Scroll right">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>

  {/*
    A scrollable region must be focusable so it can be reached and driven with
    the keyboard; the role + label give it a name in the accessibility tree.
  */}
  <ul class="track" tabindex="0" role="group" aria-label={label}>
    {
      repos.map((repo) => (
        <li>
          <a href={repo.url} rel="noopener noreferrer">
            <span class="top">
              <span class="name">{repo.name}</span>
              <span class="stars">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M8 .5l2.2 4.6 5 .7-3.6 3.5.9 5L8 11.9 3.5 14.3l.9-5L.8 5.8l5-.7z" />
                </svg>
                <span class="sr-only">stars:</span>
                {repo.stars}
              </span>
            </span>
            {repo.description && <span class="desc">{repo.description}</span>}
            {repo.language && <span class="lang">{repo.language}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .scroller {
    position: relative;
    margin-top: 1.5rem;
  }

  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 15.5rem;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0.25rem 0 1rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
    /* Bleed to the viewport edge so cards run off-screen rather than stopping
       awkwardly at the text column, while the first card stays aligned. */
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }

  .track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius);
  }

  .track::-webkit-scrollbar {
    height: 6px;
  }

  .track::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 3px;
  }

  .track::-webkit-scrollbar-track {
    background: transparent;
  }

  .track li {
    scroll-snap-align: start;
  }

  .track a {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    height: 100%;
    padding: 0.85rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s var(--ease);
  }

  .track a:hover {
    border-color: var(--accent);
  }

  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .name {
    font-family: var(--font-mono);
    font-size: 0.83rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .stars {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    font-size: 0.78rem;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .stars svg {
    width: 10px;
    height: 10px;
    fill: currentColor;
  }

  .desc {
    font-size: 0.83rem;
    color: var(--ink-muted);
    line-height: 1.45;
    /* Keep every card the same height regardless of description length. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lang {
    font-size: 0.75rem;
    color: var(--ink-faint);
    margin-top: 0.1rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .controls {
    position: absolute;
    top: -2.3rem;
    right: 0;
    display: flex;
    gap: 0.3rem;
  }

  .controls button {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    background: var(--bg);
    color: var(--ink-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease), opacity 0.15s var(--ease);
  }

  .controls button:hover:not(:disabled) {
    color: var(--accent);
    border-color: var(--accent);
  }

  .controls button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .controls svg {
    width: 14px;
    height: 14px;
  }

  /* Touch devices swipe; the buttons are redundant clutter there. */
  @media (hover: none) {
    .controls {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".scroller").forEach((scroller) => {
    const track = scroller.querySelector<HTMLUListElement>(".track");
    const buttons = scroller.querySelectorAll<HTMLButtonElement>(".controls button");
    if (!track) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const syncButtons = () => {
      const max = track.scrollWidth - track.clientWidth;
      buttons.forEach((button) => {
        const dir = Number(button.dataset.dir);
        button.disabled = dir < 0 ? track.scrollLeft <= 1 : track.scrollLeft >= max - 1;
      });
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        // Page by whatever is currently visible, less one card of overlap.
        const step = Math.max(track.clientWidth - 160, 200);
        track.scrollBy({
          left: step * Number(button.dataset.dir),
          behavior: reduceMotion ? "auto" : "smooth",
        });
      });
    });

    track.addEventListener("scroll", syncButtons, { passive: true });
    window.addEventListener("resize", syncButtons, { passive: true });
    syncButtons();
  });
</script>
