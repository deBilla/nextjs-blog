---
import { Image } from "astro:assets";
import { NAV, SITE } from "../site";
import portfolio from "../data/portfolio.json";
import profile from "../assets/profile.png";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname.replace(/\.html$/, "");
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);

// Email lives on the CV, where anyone actually looking to make contact will be.
// The "Blog" entry is the Medium profile — labelled by the platform so it does
// not read as a second blog alongside this one.
const socials = portfolio.socials
  .filter((s) => s.title !== "Email")
  .map((s) => ({ ...s, title: ({ Blog: "Medium", Github: "GitHub" })[s.title] ?? s.title }));
---

<aside class="sidebar">
  <div class="identity">
    <!-- Already cropped square and masked to a circle by scripts/profile-avatar.py,
         so this only needs sizing. border-radius keeps the border on the circle. -->
    <Image
      class="portrait"
      src={profile}
      alt={SITE.author}
      width={176}
      densities={[1, 2]}
      loading="eager"
    />
    <a href="/" class="name">
      <span class="mark" aria-hidden="true"></span>
      {SITE.author}
    </a>
    <p class="tagline">{SITE.tagline}</p>
  </div>

  <nav aria-label="Primary">
    <ul>
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="elsewhere">
    <ul>
      {
        socials.map((social) => (
          <li>
            <a href={social.link} rel="me noopener noreferrer">
              {social.title}
            </a>
          </li>
        ))
      }
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
    <ThemeToggle />
  </div>
</aside>

<style>
  .sidebar {
    display: grid;
    gap: 1.75rem;
    padding: 2.5rem var(--gutter) 0;
  }

  /* --- Identity --------------------------------------------------------- */

  .portrait {
    display: block;
    width: 5.5rem;
    height: 5.5rem;
    margin-bottom: 1.1rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }

  .name {
    /* Block rather than flex so a wrapped surname starts at the dot's left
       edge, flush with the tagline and nav, instead of being indented to hang
       under the given name. */
    display: block;
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    text-decoration: none;
    text-wrap: balance;
  }

  .mark {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
    /* Lifted off the baseline to sit against the x-height of the first line. */
    vertical-align: 0.18em;
  }

  .tagline {
    margin-top: 0.7rem;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  /* --- Navigation ------------------------------------------------------- */

  nav ul,
  .elsewhere ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  nav ul {
    display: grid;
    gap: 0.3rem;
  }

  nav a {
    display: block;
    font-size: var(--step-0);
    color: var(--ink-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent);
  }

  /* Marked with colour and weight rather than a dot in the gutter: as a column
     the sidebar scrolls its own overflow, which would clip anything positioned
     outside its box. */
  nav a[aria-current="page"] {
    color: var(--accent);
    font-weight: 500;
  }

  /* --- Elsewhere -------------------------------------------------------- */

  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .elsewhere ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin-right: auto;
  }

  .elsewhere a {
    font-size: var(--step--1);
    color: var(--ink-faint);
    text-decoration: none;
  }

  .elsewhere a:hover {
    color: var(--accent);
  }

  /* --- As a column ------------------------------------------------------ */

  @media (min-width: 64rem) {
    .sidebar {
      position: sticky;
      top: 0;
      max-height: 100dvh;
      overflow-y: auto;
      padding: 3.5rem 0 2rem;
      gap: 2.25rem;
      /* Scrollbar only when the sidebar genuinely overflows a short viewport. */
      scrollbar-width: thin;
    }

    .portrait {
      width: 6.5rem;
      height: 6.5rem;
    }

    .name {
      font-size: var(--step-2);
    }

    .elsewhere {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .elsewhere ul {
      flex-direction: column;
      gap: 0.45rem;
      margin-right: 0;
    }
  }

  @media print {
    .sidebar {
      display: none;
    }
  }
</style>
